rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'metaraplus.metaranews@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isValidEmployee(data) {
      return data.keys().hasAll(['uid', 'employeeNumber', 'name', 'email', 'department', 'position', 'role']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.employeeNumber is string && data.employeeNumber.size() <= 50 &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 150 &&
             data.department is string && data.department.size() <= 100 &&
             data.position is string && data.position.size() <= 100 &&
             data.role in ['admin', 'employee'];
    }

    function isValidAttendance(data) {
      return data.keys().hasAll(['employeeId', 'userId', 'employeeName', 'date', 'status']) &&
             data.employeeId is string && data.employeeId.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.employeeName is string && data.employeeName.size() <= 100 &&
             data.date is string && data.date.size() <= 20 &&
             data.status in ['present', 'late', 'half_day', 'absent'];
    }

    function isValidOfficeSetting(data) {
      return data.keys().hasAll(['name', 'latitude', 'longitude', 'radiusMeters', 'workStartTime', 'workEndTime']) &&
             data.name is string && data.name.size() <= 100 &&
             data.latitude is number &&
             data.longitude is number &&
             data.radiusMeters is number &&
             data.workStartTime is string && data.workStartTime.size() <= 10 &&
             data.workEndTime is string && data.workEndTime.size() <= 10;
    }

    // Admins Collection
    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Office Settings Collection
    match /settings/{settingId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(settingId) && isValidOfficeSetting(incoming());
      allow delete: if isAdmin() && isValidId(settingId);
    }

    // Employees Collection
    match /employees/{employeeId} {
      allow get: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(employeeId) && isValidEmployee(incoming()) && (
        isAdmin() || (
          incoming().uid == request.auth.uid &&
          incoming().role == 'employee'
        )
      );
      allow update: if isSignedIn() && isValidId(employeeId) && isValidEmployee(incoming()) && (
        isAdmin() || (
          resource.data.uid == request.auth.uid &&
          incoming().uid == request.auth.uid &&
          incoming().role == resource.data.role
        )
      );
      allow delete: if isAdmin() && isValidId(employeeId);
    }

    // Attendance Collection
    match /attendances/{attendanceId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(attendanceId) && isValidAttendance(incoming()) && (
        isAdmin() || (
          incoming().userId == request.auth.uid
        )
      );
      allow update: if isSignedIn() && isValidId(attendanceId) && isValidAttendance(incoming()) && (
        isAdmin() || (
          resource.data.userId == request.auth.uid &&
          incoming().userId == request.auth.uid
        )
      );
      allow delete: if isAdmin() && isValidId(attendanceId);
    }
  }
}
